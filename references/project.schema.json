{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vocabulary scene comic prompt project",
  "description": "词表到主题与分页提示词的数据约定。跨记录引用及覆盖率需另作语义校验。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "sample",
            "full"
          ]
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "const": "zh-CN"
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aspect_ratio": {
              "type": "string",
              "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "target_min_words": {
              "type": "integer",
              "minimum": 1
            },
            "target_max_words": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "aspect_ratio",
            "width",
            "height",
            "target_min_words",
            "target_max_words"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "title",
        "scope",
        "source_name",
        "audience",
        "locale",
        "defaults"
      ]
    },
    "style_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "positive_prompt": {
          "type": "string",
          "minLength": 1
        },
        "negative_prompt": {
          "type": "string",
          "minLength": 1
        },
        "reference_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "positive_prompt",
        "negative_prompt",
        "reference_note"
      ]
    },
    "source_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_entry"
      },
      "minItems": 1
    },
    "themes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/theme"
      },
      "minItems": 1
    },
    "classifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/classification"
      },
      "minItems": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      },
      "minItems": 0
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "classified_count": {
          "type": "integer",
          "minimum": 0
        },
        "first_teaching_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_entry_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unplaced_entry_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "review_occurrence_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "scope_entry_count",
        "classified_count",
        "first_teaching_count",
        "pending_entry_ids",
        "unplaced_entry_ids",
        "review_occurrence_count"
      ]
    },
    "supplements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supplement"
      }
    }
  },
  "required": [
    "schema_version",
    "project",
    "style_profile",
    "source_entries",
    "themes",
    "classifications",
    "pages",
    "coverage",
    "supplements"
  ],
  "$defs": {
    "source_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "source_locator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "sheet": {
              "type": [
                "string",
                "null"
              ]
            },
            "row": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "file",
            "sheet",
            "row"
          ]
        },
        "original": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serial": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "word": {
              "type": "string",
              "minLength": 1
            },
            "phonetic": {
              "type": [
                "string",
                "null"
              ]
            },
            "meaning": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "serial",
            "word",
            "phonetic",
            "meaning"
          ]
        },
        "review_status": {
          "enum": [
            "ready",
            "pending_review"
          ]
        },
        "review_note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_locator",
        "original",
        "review_status",
        "review_note"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scene_directions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "scene_directions"
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "theme_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "selected_meaning": {
          "type": [
            "string",
            "null"
          ]
        },
        "part_of_speech": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "enum": [
            "ready",
            "pending_review"
          ]
        }
      },
      "required": [
        "entry_id",
        "theme_id",
        "selected_meaning",
        "part_of_speech",
        "reason",
        "review_status"
      ]
    },
    "vocabulary_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "display_word": {
          "type": "string",
          "minLength": 1
        },
        "display_phonetic": {
          "type": "string",
          "minLength": 1
        },
        "display_part_of_speech": {
          "type": "string",
          "minLength": 1
        },
        "display_meaning": {
          "type": "string",
          "minLength": 1
        },
        "teaching_role": {
          "enum": [
            "first",
            "review"
          ]
        },
        "review_reason": {
          "type": "string"
        },
        "visual_target": {
          "type": "string",
          "minLength": 1
        },
        "label_position": {
          "type": "string",
          "minLength": 1
        },
        "link_mode": {
          "enum": [
            "arrow",
            "context"
          ]
        }
      },
      "required": [
        "entry_id",
        "display_word",
        "display_phonetic",
        "display_part_of_speech",
        "display_meaning",
        "teaching_role",
        "review_reason",
        "visual_target",
        "label_position",
        "link_mode"
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "relative_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "scene_description": {
          "type": "string",
          "minLength": 1
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "vocabulary_entry_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "order",
        "relative_height",
        "scene_description",
        "character_ids",
        "vocabulary_entry_ids"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "theme_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "story": {
          "type": "string",
          "minLength": 1
        },
        "scene_setting": {
          "type": "string",
          "minLength": 1
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "description"
            ]
          },
          "minItems": 1
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vocabulary_item"
          },
          "minItems": 1
        },
        "layout": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          },
          "minItems": 1
        },
        "composition_notes": {
          "type": "string",
          "minLength": 1
        },
        "style_profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ready_to_copy": {
              "type": "string",
              "minLength": 1
            },
            "negative_prompt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ready_to_copy",
            "negative_prompt"
          ]
        },
        "qa_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "status": {
          "enum": [
            "prompt_ready",
            "pending_review"
          ]
        }
      },
      "required": [
        "id",
        "page_number",
        "theme_id",
        "title",
        "subtitle",
        "story",
        "scene_setting",
        "characters",
        "vocabulary",
        "layout",
        "composition_notes",
        "style_profile_id",
        "prompt",
        "qa_checks",
        "status"
      ]
    },
    "supplement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "phonetic": {
          "type": [
            "string",
            "null"
          ]
        },
        "meaning": {
          "type": [
            "string",
            "null"
          ]
        },
        "part_of_speech": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "enum": [
            "verified",
            "pending_review"
          ]
        }
      },
      "required": [
        "entry_id",
        "phonetic",
        "meaning",
        "part_of_speech",
        "evidence",
        "verification_status"
      ]
    }
  }
}
